<?xml version="1.0"?>
<package format="3">
  <name>cosim_bridge</name><version>0.1.0</version>
  <description>Readable SUMO to ROS2 state bridge.</description>
  <maintainer email="learner@example.com">CoSimDemo learner</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>cosim_interfaces</depend>
  <exec_depend>rclpy</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend><exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend><exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_sensor_msgs</exec_depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>cosim_rviz</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>gz_transport_vendor</exec_depend><exec_depend>gz_msgs_vendor</exec_depend>
  <exec_depend>std_msgs</exec_depend><exec_depend>sensor_msgs</exec_depend><exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>cv_bridge</exec_depend><exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend><exec_depend>builtin_interfaces</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
