<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Identity link pose; camera poses relative to vehicle: x forward, y left, z up. -->
  <model name="surround_camera_rig">
    <static>true</static>
    <link name="surround_camera_mount">
      <!-- Side housings touch the windows; optical origins lie outside the housings. -->
      <visual name="left_housing">
        <pose>0.65 0.97 1.30 0 0 0</pose>
        <geometry><box><size>0.18 0.34 0.12</size></box></geometry>
        <material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material>
      </visual>
      <visual name="left_lens">
        <pose>0.65 1.14 1.30 0 0 0</pose>
        <geometry><box><size>0.055 0.02 0.055</size></box></geometry>
        <material><ambient>0.2 0.6 1 1</ambient><diffuse>0.2 0.6 1 1</diffuse></material>
      </visual>
      <visual name="right_housing">
        <pose>0.65 -0.97 1.30 0 0 0</pose>
        <geometry><box><size>0.18 0.34 0.12</size></box></geometry>
        <material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material>
      </visual>
      <visual name="right_lens">
        <pose>0.65 -1.14 1.30 0 0 0</pose>
        <geometry><box><size>0.055 0.02 0.055</size></box></geometry>
        <material><ambient>0.2 0.6 1 1</ambient><diffuse>0.2 0.6 1 1</diffuse></material>
      </visual>
      <visual name="rear_housing">
        <pose>-2.53 0 0.95 0 0 0</pose>
        <geometry><box><size>0.14 0.18 0.12</size></box></geometry>
        <material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material>
      </visual>
      <visual name="rear_lens">
        <pose>-2.60 0 0.95 0 0 0</pose>
        <geometry><box><size>0.02 0.055 0.055</size></box></geometry>
        <material><ambient>0.2 0.6 1 1</ambient><diffuse>0.2 0.6 1 1</diffuse></material>
      </visual>
      <sensor name="left" type="camera">
        <pose>0.65 1.16 1.30 0 0.1745329252 1.9198621772</pose>
        <always_on>true</always_on><update_rate>15</update_rate>
        <camera><horizontal_fov>2.0943951024</horizontal_fov><image><width>640</width><height>360</height><format>R8G8B8</format></image><clip><near>0.05</near><far>150</far></clip></camera>
      </sensor>
      <sensor name="right" type="camera">
        <pose>0.65 -1.16 1.30 0 0.1745329252 -1.9198621772</pose>
        <always_on>true</always_on><update_rate>15</update_rate>
        <camera><horizontal_fov>2.0943951024</horizontal_fov><image><width>640</width><height>360</height><format>R8G8B8</format></image><clip><near>0.05</near><far>150</far></clip></camera>
      </sensor>
      <sensor name="rear" type="camera">
        <pose>-2.62 0 0.95 0 0 3.1415926536</pose>
        <always_on>true</always_on><update_rate>15</update_rate>
        <camera><horizontal_fov>2.4434609528</horizontal_fov><image><width>640</width><height>360</height><format>R8G8B8</format></image><clip><near>0.05</near><far>150</far></clip></camera>
      </sensor>
    </link>
  </model>
</sdf>
