<?xml version="1.0"?>
<sdf version="1.9">
  <!-- x forward, y left, z up; sensor poses are relative to the car base. -->
  <model name="corner_radar_rig">
    <static>true</static>
    <link name="radar_front_left_mount">
      <visual name="front_left_housing">
        <pose>2.45 0.9 0.65 0 0 0</pose>
        <geometry><box><size>0.18 0.12 0.12</size></box></geometry>
        <material><ambient>1 0.55 0.05 1</ambient><diffuse>1 0.55 0.05 1</diffuse></material>
      </visual>
      <!-- Range-ray approximation of a corner radar, not an RF model. -->
      <sensor name="front_left" type="gpu_lidar">
        <pose>2.55 0.97 0.65 0 0 1.5707963268</pose>
        <always_on>true</always_on><update_rate>20</update_rate>
        <lidar>
          <scan>
            <horizontal><samples>240</samples><resolution>1</resolution><min_angle>-1.5707963268</min_angle><max_angle>1.5707963268</max_angle></horizontal>
            <vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.2617993878</min_angle><max_angle>0.2617993878</max_angle></vertical>
          </scan>
          <range><min>0.3</min><max>30</max><resolution>0.05</resolution></range>
        </lidar>
      </sensor>
    </link>
    <link name="radar_front_right_mount">
      <visual name="front_right_housing">
        <pose>2.45 -0.9 0.65 0 0 0</pose>
        <geometry><box><size>0.18 0.12 0.12</size></box></geometry>
        <material><ambient>1 0.2 0.7 1</ambient><diffuse>1 0.2 0.7 1</diffuse></material>
      </visual>
      <!-- Range-ray approximation of a corner radar, not an RF model. -->
      <sensor name="front_right" type="gpu_lidar">
        <pose>2.55 -0.97 0.65 0 0 -1.5707963268</pose>
        <always_on>true</always_on><update_rate>20</update_rate>
        <lidar>
          <scan>
            <horizontal><samples>240</samples><resolution>1</resolution><min_angle>-1.5707963268</min_angle><max_angle>1.5707963268</max_angle></horizontal>
            <vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.2617993878</min_angle><max_angle>0.2617993878</max_angle></vertical>
          </scan>
          <range><min>0.3</min><max>30</max><resolution>0.05</resolution></range>
        </lidar>
      </sensor>
    </link>
    <link name="radar_rear_left_mount">
      <visual name="rear_left_housing">
        <pose>-2.45 0.9 0.65 0 0 0</pose>
        <geometry><box><size>0.18 0.12 0.12</size></box></geometry>
        <material><ambient>0.6 0.3 1 1</ambient><diffuse>0.6 0.3 1 1</diffuse></material>
      </visual>
      <!-- Range-ray approximation of a corner radar, not an RF model. -->
      <sensor name="rear_left" type="gpu_lidar">
        <pose>-2.55 0.97 0.65 0 0 2.3561944902</pose>
        <always_on>true</always_on><update_rate>20</update_rate>
        <lidar>
          <scan>
            <horizontal><samples>240</samples><resolution>1</resolution><min_angle>-1.5707963268</min_angle><max_angle>1.5707963268</max_angle></horizontal>
            <vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.2617993878</min_angle><max_angle>0.2617993878</max_angle></vertical>
          </scan>
          <range><min>0.3</min><max>30</max><resolution>0.05</resolution></range>
        </lidar>
      </sensor>
    </link>
    <link name="radar_rear_right_mount">
      <visual name="rear_right_housing">
        <pose>-2.45 -0.9 0.65 0 0 0</pose>
        <geometry><box><size>0.18 0.12 0.12</size></box></geometry>
        <material><ambient>0.1 0.8 1 1</ambient><diffuse>0.1 0.8 1 1</diffuse></material>
      </visual>
      <!-- Range-ray approximation of a corner radar, not an RF model. -->
      <sensor name="rear_right" type="gpu_lidar">
        <pose>-2.55 -0.97 0.65 0 0 -2.3561944902</pose>
        <always_on>true</always_on><update_rate>20</update_rate>
        <lidar>
          <scan>
            <horizontal><samples>240</samples><resolution>1</resolution><min_angle>-1.5707963268</min_angle><max_angle>1.5707963268</max_angle></horizontal>
            <vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.2617993878</min_angle><max_angle>0.2617993878</max_angle></vertical>
          </scan>
          <range><min>0.3</min><max>30</max><resolution>0.05</resolution></range>
        </lidar>
      </sensor>
    </link>
  </model>
</sdf>
