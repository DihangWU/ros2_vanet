Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 30
    - Class: rviz_default_plugins/MarkerArray
      Name: Cars road and status
      Enabled: true
      Topic:
        Value: /demo/markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
    - Class: rviz_default_plugins/Path
      Name: Car A path
      Enabled: true
      Color: 255; 60; 60
      Line Style: Lines
      Line Width: 0.2
      Topic:
        Value: /car_a/path
    - Class: rviz_default_plugins/Path
      Name: Car B path
      Enabled: true
      Color: 60; 110; 255
      Topic:
        Value: /car_b/path
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 2
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 150
      Pitch: 0.55
      Yaw: 4.71
      Focal Point:
        X: 125
        Y: 0
        Z: 0
      Target Frame: map
Window Geometry:
  Width: 1280
  Height: 800
